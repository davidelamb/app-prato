{
  "name": "appprato",
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "wrangler": "^4.114.0"
  },
  "scripts": {
    "logo:apply": "node scripts/apply-logo-assets.cjs",
    "prestart": "npm run logo:apply",
    "start": "expo start",
    "preandroid": "npm run logo:apply",
    "android": "expo start --android",
    "preios": "npm run logo:apply",
    "ios": "expo start --ios",
    "preweb": "npm run logo:apply",
    "web": "expo start --web",
    "prebuild:web": "npm run logo:apply",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "import-rosters": "node scripts/import-team-rosters.cjs",
    "verify:core": "node scripts/verify-core-match-system.cjs",
    "verify:rosters": "node scripts/verify-roster-matching.cjs",
    "verify:season": "node scripts/verify-full-season.cjs",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply app-prato-content --local",
    "db:migrate:remote": "wrangler d1 migrations apply app-prato-content --remote",
    "season:generate": "node scripts/generate-full-season.cjs > src/data/full-season-2026-27.ts"
  },
  "private": true
}
