{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-prato",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MEDIA_UPLOADS_ENABLED": "true",
    "MEDIA_STORAGE_LIMIT_BYTES": "9500000000",
    "MEDIA_MONTHLY_UPLOAD_LIMIT": "50000"
  },
  "secrets": {
    "required": ["ADMIN_TOKEN"]
  },
  "build": {
    "command": "npm install --no-package-lock --no-audit --no-fund && npm run build:web"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "app-prato-content",
      "database_id": "7edf2d5f-a04e-4aed-800e-bd14f27c048a",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "app-prato-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
